#!/usr/bin/env bash
# Resolves the current Cursor editor download URLs published on
# https://cursor.com/downloads. Prints "deb_url=<url>" and "rpm_url=<url>"
# (values may be empty).
set -euo pipefail

UA="{{ cursor_user_agent }}"
ARCH="{{ cursor_arch_sub }}"
DOWNLOADS_URL="{{ cursor_downloads_url }}"

empty_result() {
  echo "deb_url="
  echo "rpm_url="
  exit 0
}

page=$(curl -fsSL --max-time 30 -A "$UA" "$DOWNLOADS_URL" 2>/dev/null) || empty_result
[[ -n "$page" ]] || empty_result

case "$ARCH" in
  x64) label_arch="x64" ;;
  arm64) label_arch="ARM64" ;;
  *) empty_result ;;
esac

# The downloads page has used two shapes over time: plain HTML links to
# api2.cursor.sh (current) and escaped JSON with a downloadUrl field. Accept
# both, then keep the highest version.
resolve() {
  local suffix="$1" label="$2"
  {
    printf '%s' "$page" \
      | grep -oE "https://api2\.cursor\.sh/updates/download/golden/linux-$ARCH-$suffix/cursor/[0-9]+(\.[0-9]+)*" || true
    printf '%s' "$page" \
      | grep -oE "Linux $label \($label_arch\)\\\\\",\\\\\"downloadUrl\\\\\":\\\\\"https://[^\\\\\"]+" \
      | grep -oE 'https://[^\\"]+' || true
  } | sort -V | tail -1
}

deb_url=$(resolve deb '\.deb')
rpm_url=$(resolve rpm 'RPM')

echo "deb_url=$deb_url"
echo "rpm_url=$rpm_url"
