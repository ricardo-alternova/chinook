#!/usr/bin/env bash
# Chinook one-line installer.
# curl -fsSL https://github.com/ricardo-alternova/chinook/releases/latest/download/install | bash
# wget -qO- https://github.com/ricardo-alternova/chinook/releases/latest/download/install | bash works too.
# Keep this script working on macOS's bash 3.2.
set -euo pipefail

CHINOOK_REPO="${CHINOOK_REPO:-https://github.com/ricardo-alternova/chinook.git}"
CHINOOK_DIR="${CHINOOK_DIR:-$HOME/chinook}"
CHINOOK_REF="${CHINOOK_REF:-main}"
CHINOOK_UBUNTU_VERSION="24.04"

banner() {
  cat <<'EOF'
   _____ _     _
  / ____| |__ (_)_ __   ___   ___ | | __
 | |    | '_ \| | '_ \ / _ \ / _ \| |/ /
 | |___ | | | | | | | | (_) | (_) |   <
  \____|_| |_|_|_| |_|\___/ \___/|_|\_\

  Fresh Linux or macOS → daily driver
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

need_tty() {
  [[ -r /dev/tty && -w /dev/tty ]] || die "Chinook needs an interactive terminal (prompts and sudo)."
}

prompt_enter() {
  echo
  echo "Begin installation (Ctrl+C to abort)."
  read -r -p "Press Enter to continue. " _ </dev/tty
}

is_macos() {
  [[ "$(uname -s)" == Darwin ]]
}

detect_os() {
  if is_macos; then
    CHINOOK_OS_LABEL="macOS $(sw_vers -productVersion)"
    CHINOOK_PROFILE=macos
    CHINOOK_PLAYBOOK=ansible/playbooks/macos.yml
    return
  fi

  [[ -r /etc/os-release ]] || die "Unsupported system: /etc/os-release is missing."
  # shellcheck disable=SC1091
  . /etc/os-release

  case "${ID:-}" in
    ubuntu)
      CHINOOK_OS_LABEL="Ubuntu ${VERSION_ID:-}"
      if [[ "${VERSION_ID:-}" != "$CHINOOK_UBUNTU_VERSION" ]]; then
        echo "warning: Chinook's Ubuntu profiles are built and tested for Ubuntu $CHINOOK_UBUNTU_VERSION LTS. Ubuntu ${VERSION_ID:-unknown} may work, but packages that don't exist on it are skipped."
      fi
      choose_ubuntu_profile
      ;;
    fedora)
      CHINOOK_PROFILE=fedora_asahi
      if [[ "${NAME:-} ${VARIANT:-} ${VERSION:-}" == *[Aa]sahi* ]] || uname -r | grep -qi asahi; then
        CHINOOK_OS_LABEL="Fedora Asahi Remix ${VERSION_ID:-}"
      else
        CHINOOK_OS_LABEL="Fedora ${VERSION_ID:-}"
        echo "Fedora detected. Chinook's Fedora profile targets Asahi Remix + KDE; other desktops may skip or fail KDE steps."
      fi
      ;;
    *)
      die "Unsupported OS '${ID:-unknown}'. Chinook supports Ubuntu (GNOME or Server), Fedora Asahi Remix (KDE), and macOS."
      ;;
  esac

  case "$CHINOOK_PROFILE" in
    ubuntu) CHINOOK_PLAYBOOK=ansible/playbooks/ubuntu.yml ;;
    ubuntu_server) CHINOOK_PLAYBOOK=ansible/playbooks/ubuntu_server.yml ;;
    fedora_asahi) CHINOOK_PLAYBOOK=ansible/playbooks/fedora_asahi.yml ;;
    *) die "Unknown profile '$CHINOOK_PROFILE'." ;;
  esac
}

choose_ubuntu_profile() {
  if [[ -n "${CHINOOK_PROFILE:-}" ]]; then
    case "$CHINOOK_PROFILE" in
      ubuntu|ubuntu_server) return ;;
      *) die "On Ubuntu, CHINOOK_PROFILE must be ubuntu or ubuntu_server (got '$CHINOOK_PROFILE')." ;;
    esac
  fi

  local default=ubuntu_server
  local hint="no GNOME detected"
  if command -v gnome-shell >/dev/null 2>&1 || [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then
    default=ubuntu
    hint="GNOME detected"
  elif [[ "${VARIANT_ID:-}${VARIANT:-}${PRETTY_NAME:-}" == *[Ss]erver* ]]; then
    hint="Ubuntu Server variant"
  fi

  echo "Detected $CHINOOK_OS_LABEL ($hint)."
  echo "  1. Ubuntu GNOME"
  echo "  2. Ubuntu Server (headless / remote agent box)"
  local pick default_n=2
  [[ "$default" == ubuntu ]] && default_n=1
  read -r -p "Choose profile [1/2] (default ${default_n}): " pick </dev/tty
  pick="${pick:-$default_n}"
  pick="${pick//[[:space:]]/}"
  case "$pick" in
    1) CHINOOK_PROFILE=ubuntu ;;
    2) CHINOOK_PROFILE=ubuntu_server ;;
    *) die "Enter 1 or 2." ;;
  esac
}

load_homebrew() {
  local brew
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$brew" ]]; then
      eval "$("$brew" shellenv)"
      return 0
    fi
  done
  return 1
}

# Homebrew also installs the Command Line Tools, which provide git and python3.
ensure_homebrew() {
  load_homebrew && return 0
  echo "Installing Homebrew (it asks for your password)..."
  sudo -v
  local installer
  # set -e doesn't see a failure inside $( ), so check the download explicitly.
  installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || die "Could not download the Homebrew installer."
  NONINTERACTIVE=1 /bin/bash -c "$installer"
  load_homebrew || die "Homebrew installed, but brew was not found in /opt/homebrew or /usr/local."
}

pkg_install() {
  if is_macos; then
    ensure_homebrew
    command -v ansible-playbook >/dev/null 2>&1 || brew install ansible
    return
  fi
  case "${ID:-}" in
    ubuntu)
      sudo DEBIAN_FRONTEND=noninteractive apt-get update -y
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y git ansible python3
      ;;
    fedora)
      sudo dnf install -y git ansible python3
      ;;
    *)
      die "No package manager path for '${ID:-unknown}'."
      ;;
  esac
}

ensure_git() {
  if is_macos; then
    # /usr/bin/git is only a stub until the Command Line Tools are installed.
    xcode-select -p >/dev/null 2>&1 && return 0
    ensure_homebrew
    command -v git >/dev/null 2>&1 || die "git is required; open a new terminal and re-run after the Command Line Tools finish installing."
    return
  fi
  command -v git >/dev/null 2>&1 && return 0
  echo "Installing git..."
  [[ -r /etc/os-release ]] || die "Unsupported system: /etc/os-release is missing."
  # shellcheck disable=SC1091
  . /etc/os-release
  case "${ID:-}" in
    ubuntu)
      sudo DEBIAN_FRONTEND=noninteractive apt-get update -y
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y git
      ;;
    fedora)
      sudo dnf install -y git
      ;;
    *)
      die "Install git, then re-run."
      ;;
  esac
}

in_repo_root() {
  local src="${BASH_SOURCE[0]:-}"
  [[ -n "$src" && -f "$src" ]] || return 1
  [[ "$src" == /dev/fd/* || "$src" == /proc/self/fd/* ]] && return 1
  local here
  here="$(cd "$(dirname "$src")" && pwd)"
  [[ -f "$here/tools/configure.py" ]] || return 1
  printf '%s\n' "$here"
}

clone_or_update() {
  if [[ -d "$CHINOOK_DIR/.git" ]]; then
    echo "Updating Chinook in $CHINOOK_DIR ..."
    git -C "$CHINOOK_DIR" remote set-url origin "$CHINOOK_REPO"
    git -C "$CHINOOK_DIR" fetch --depth 1 origin "$CHINOOK_REF"
    git -C "$CHINOOK_DIR" reset --hard FETCH_HEAD
    return
  fi

  if [[ -e "$CHINOOK_DIR" ]] && [[ -n "$(ls -A "$CHINOOK_DIR" 2>/dev/null)" ]]; then
    die "$CHINOOK_DIR exists and is not a Chinook checkout. Set CHINOOK_DIR to an empty path."
  fi

  echo "Cloning Chinook into $CHINOOK_DIR ..."
  git clone --depth 1 --branch "$CHINOOK_REF" "$CHINOOK_REPO" "$CHINOOK_DIR"
}

check_os() {
  case "$(uname -s)" in
    Linux|Darwin) ;;
    *) die "Chinook is for Linux and macOS. Detected $(uname -s)." ;;
  esac
}

bootstrap() {
  check_os
  [[ "${EUID:-$(id -u)}" -ne 0 ]] || die "Run as your user, not root. The installer will sudo when needed."
  need_tty
  banner
  echo
  if is_macos; then
    echo "This will install Homebrew (with git and python3) and ansible, then help you pick apps."
  else
    echo "This will install git, ansible, and python3, then help you pick apps."
  fi
  prompt_enter

  local root
  if root="$(in_repo_root)"; then
    echo "Using existing checkout at $root"
    exec bash "$root/install" --in-repo </dev/tty
  fi

  ensure_git
  clone_or_update
  exec bash "$CHINOOK_DIR/install" --in-repo </dev/tty
}

run_from_repo() {
  check_os
  [[ "${EUID:-$(id -u)}" -ne 0 ]] || die "Run as your user, not root. The installer will sudo when needed."
  need_tty

  local root
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$root"

  detect_os
  echo
  echo "Detected $CHINOOK_OS_LABEL → profile '$CHINOOK_PROFILE'"
  echo "Installing prerequisites..."
  pkg_install

  command -v python3 >/dev/null 2>&1 || die "python3 is required."
  command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook is required."

  local local_vars="$root/ansible/group_vars/local.yml"
  local configure=1
  if [[ -f "$local_vars" ]]; then
    echo
    echo "Found existing $local_vars"
    read -r -p "Re-run the app selector? [y/N] " reply </dev/tty
    [[ "${reply:-}" =~ ^[Yy]$ ]] || configure=0
  fi

  if [[ "$configure" -eq 1 ]]; then
    python3 "$root/tools/configure.py" --profile "$CHINOOK_PROFILE"
  fi

  [[ -f "$local_vars" ]] || die "No local.yml generated; aborting before the playbook."

  echo
  echo "Running $CHINOOK_PLAYBOOK ..."
  local become=()
  # Newer Ubuntu releases default to sudo-rs, whose password prompt Ansible
  # doesn't recognize (it times out waiting for it). The classic sudo still ships
  # as sudo.ws, so have Ansible use that.
  if ! is_macos && sudo --version 2>/dev/null | grep -qi 'sudo-rs'; then
    command -v sudo.ws >/dev/null 2>&1 || sudo DEBIAN_FRONTEND=noninteractive apt-get install -y sudo
    command -v sudo.ws >/dev/null 2>&1 || die "This system uses sudo-rs, and Ansible needs the classic sudo (sudo.ws)."
    echo "sudo-rs detected; Ansible will use sudo.ws."
    export ANSIBLE_BECOME_EXE=sudo.ws
  fi
  # The prerequisite step above leaves sudo credentials cached for this terminal,
  # which would make `sudo -n` pass even without NOPASSWD. Ansible's sudo can't
  # use that cache, so drop it and only skip the password prompt for real NOPASSWD.
  sudo -k
  if sudo -n true 2>/dev/null; then
    echo "Passwordless sudo detected."
  else
    become=(--ask-become-pass)
  fi
  # bash 3.2 treats an empty array as unset under set -u.
  ansible-playbook "$CHINOOK_PLAYBOOK" ${become[@]+"${become[@]}"}

  if is_macos; then
    cat <<'EOF'

Chinook is ready.

Next steps:
  1. If you picked Fleet, check that the Fleet Desktop icon shows in the menu bar.
  2. If Chinook renamed this Mac, restart it so every app picks up the new name.

That is it.
EOF
    return
  fi

  cat <<'EOF'

Chinook is ready.

Next steps:
  1. Open OpenCode and set up your credentials (`opencode auth login`) so you can tweak the OS using AI.
  2. Set up your GitHub / GitLab accounts.
  3. If you picked the Comp AI agent, open comp-ai-device-agent from the app menu and sign in with your work email.
  4. If Chinook renamed this device, reboot so every app picks up the new name.

That is it.
EOF
}

if command -v curl >/dev/null 2>&1; then
  CHINOOK_RETRY="curl -fsSL https://github.com/ricardo-alternova/chinook/releases/latest/download/install | bash"
else
  CHINOOK_RETRY="wget -qO- https://github.com/ricardo-alternova/chinook/releases/latest/download/install | bash"
fi
trap 'echo "Chinook installation failed. Retry with: $CHINOOK_RETRY"' ERR

if [[ "${1:-}" == "--in-repo" ]]; then
  run_from_repo
else
  bootstrap
fi
